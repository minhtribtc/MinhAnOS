{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "lucide-vue-next": [
        "./node_modules/lucide-vue-next"
      ],
      "@minhanos/files-app": [
        "../../packages/files-app/src/index.ts"
      ],
      "vue": [
        "./node_modules/vue"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts"
  ]
}
