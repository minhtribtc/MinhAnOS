{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/security-notice.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "recipientId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "password.changed",
        "password.reset",
        "role.changed",
        "sessions.revoked",
        "login.failures",
        "recovery.consumed"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "mandatory": {
      "type": "boolean"
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "realm": {
          "enum": [
            "desktop",
            "files"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21
        }
      }
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "deliveredAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "recipientId",
    "kind",
    "severity",
    "mandatory",
    "details",
    "requestId",
    "createdAt",
    "deliveredAt"
  ]
}
