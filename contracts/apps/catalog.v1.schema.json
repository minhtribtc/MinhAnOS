{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/app-catalog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "repository",
    "apps"
  ],
  "properties": {
    "catalogVersion": {
      "const": "1"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "fullName"
      ],
      "properties": {
        "strategy": {
          "const": "monorepo"
        },
        "fullName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "displayName",
          "moduleName",
          "appId",
          "implementation",
          "legacyRegistryIds",
          "legacyDisplayNames",
          "currentPaths"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "moduleName": {
            "type": "string",
            "pattern": "^minhanos-[a-z][a-z0-9-]*$"
          },
          "appId": {
            "type": "string",
            "pattern": "^com\\.minhanos\\.[a-z][a-z0-9-]*$"
          },
          "implementation": {
            "enum": [
              "implemented",
              "partial",
              "planned"
            ]
          },
          "legacyRegistryIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "legacyDisplayNames": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "currentPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(apps|packages|internal)/[A-Za-z0-9_./-]+$"
            }
          }
        }
      }
    }
  }
}
