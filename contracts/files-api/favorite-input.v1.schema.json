{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-favorite-input.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "string",
      "pattern": "^(personal|system|share:[a-z0-9][a-z0-9-]{0,62}|shared:[0-9a-f]{64})$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "dir": {
      "type": "boolean"
    }
  },
  "required": [
    "root",
    "path"
  ]
}
