{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-entry.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "file",
        "folder",
        "symlink",
        "special"
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string"
    },
    "uid": {
      "type": "integer",
      "minimum": 0
    },
    "gid": {
      "type": "integer",
      "minimum": 0
    },
    "etag": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "path",
    "kind",
    "size",
    "modified",
    "mode",
    "uid",
    "gid",
    "etag"
  ]
}
