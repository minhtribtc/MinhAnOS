{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-activity-settings.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "level": {
      "enum": [
        "minimal",
        "writes",
        "access",
        "full"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "retentionDays": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "level",
    "version"
  ]
}
