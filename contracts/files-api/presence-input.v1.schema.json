{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-presence-input.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "string",
      "maxLength": 200
    },
    "rootName": {
      "type": "string",
      "maxLength": 200
    },
    "path": {
      "type": "string",
      "maxLength": 4096
    },
    "file": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "root",
    "path"
  ]
}
