{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-favorite-list.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^(personal|system|share:[a-z0-9][a-z0-9-]{0,62})$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "dir": {
            "type": "boolean"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "root",
          "path",
          "dir",
          "created"
        ]
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "items",
    "limit"
  ]
}
