{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-link-update-input.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permission": {
      "enum": [
        "view",
        "edit",
        "drop"
      ]
    },
    "expires": {
      "type": "string",
      "maxLength": 64
    },
    "clearPassword": {
      "type": "boolean"
    },
    "password": {
      "type": "string",
      "maxLength": 256
    }
  },
  "required": [
    "id",
    "permission"
  ]
}
