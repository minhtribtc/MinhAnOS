{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-grant.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "name": {
      "type": "string"
    },
    "dir": {
      "type": "boolean"
    },
    "permission": {
      "enum": [
        "view",
        "edit"
      ]
    },
    "owner": {
      "type": "string"
    },
    "granteeId": {
      "type": "string",
      "format": "uuid"
    },
    "grantee": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "path",
    "name",
    "dir",
    "permission",
    "owner",
    "granteeId",
    "grantee",
    "created"
  ]
}
