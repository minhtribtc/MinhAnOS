{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/files-write-result.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "const": true
    },
    "item": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "file",
                "folder",
                "symlink",
                "special"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "modified": {
              "type": "string",
              "format": "date-time"
            },
            "mode": {
              "type": "string"
            },
            "uid": {
              "type": "integer",
              "minimum": 0
            },
            "gid": {
              "type": "integer",
              "minimum": 0
            },
            "etag": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "path",
            "kind",
            "size",
            "modified",
            "mode",
            "uid",
            "gid",
            "etag"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            "path": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "deleted": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "path",
            "name",
            "deleted"
          ]
        }
      ]
    },
    "backup": {
      "type": "string"
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "const": "files.copy"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "unit": {
              "const": "bytes"
            }
          },
          "required": [
            "completed",
            "total",
            "unit"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "message": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "details": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "code",
                "message",
                "requestId",
                "details"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "type",
        "state",
        "progress",
        "attempt",
        "maxAttempts",
        "createdAt",
        "updatedAt",
        "error"
      ]
    }
  },
  "required": [
    "ok"
  ]
}
