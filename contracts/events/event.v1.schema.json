{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/event.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "enum": [
        "files.created.v1",
        "files.updated.v1",
        "files.deleted.v1",
        "identity.user.disabled.v1"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "eventId",
    "name",
    "schemaVersion",
    "occurredAt",
    "source",
    "subject",
    "correlationId",
    "data"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "name": {
            "const": "files.created.v1"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "etag": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "fileId",
              "version",
              "etag"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "files.updated.v1"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "etag": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "fileId",
              "version",
              "etag"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "files.deleted.v1"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "fileId",
              "version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "identity.user.disabled.v1"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "userId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "userId"
            ]
          }
        }
      }
    }
  ]
}
