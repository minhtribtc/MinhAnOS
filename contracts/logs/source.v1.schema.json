{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/logs-source.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "enum": [
        "identity",
        "storage"
      ]
    },
    "appId": {
      "type": "string"
    },
    "retentionDays": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "required": [
    "id",
    "appId",
    "retentionDays"
  ]
}
