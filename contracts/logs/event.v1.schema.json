{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/logs-event.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "enum": [
        "identity",
        "storage",
        "files"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "success",
        "denied",
        "failure"
      ]
    },
    "actor": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "username"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetName": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "source",
    "occurredAt",
    "action",
    "outcome",
    "actor",
    "target",
    "targetName",
    "requestId",
    "correlationId",
    "details"
  ]
}
