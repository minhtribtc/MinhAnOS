{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/logs-source-list.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "identity",
              "storage",
              "files"
            ]
          },
          "appId": {
            "type": "string"
          },
          "retentionDays": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "id",
          "appId",
          "retentionDays"
        ]
      }
    }
  },
  "required": [
    "items"
  ]
}
