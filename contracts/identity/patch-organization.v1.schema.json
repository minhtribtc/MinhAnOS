{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-patch-organization.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ]
    },
    "allowChildren": {
      "type": "boolean"
    }
  },
  "required": [],
  "minProperties": 1
}
