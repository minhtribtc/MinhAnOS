{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-create-organization-user.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "username": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,31}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 256,
      "writeOnly": true
    },
    "role": {
      "enum": [
        "admin",
        "member"
      ]
    }
  },
  "required": [
    "username",
    "displayName",
    "password",
    "role"
  ]
}
