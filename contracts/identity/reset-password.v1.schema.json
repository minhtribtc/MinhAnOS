{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-reset-password.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "newPassword": {
      "type": "string",
      "minLength": 12,
      "maxLength": 256
    }
  },
  "required": [
    "newPassword"
  ]
}
