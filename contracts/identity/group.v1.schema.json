{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-group.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "kind": {
      "enum": [
        "system",
        "user"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "organizationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "memberCount": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "key",
    "name",
    "kind",
    "version"
  ]
}
