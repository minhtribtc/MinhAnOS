{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-create-organization.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "allowChildren": {
      "type": "boolean"
    }
  },
  "required": [
    "name"
  ]
}
