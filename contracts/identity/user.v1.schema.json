{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-user.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "username": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,31}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "deleted"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "passwordChangeRequired": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "username",
    "displayName",
    "status",
    "version"
  ]
}
