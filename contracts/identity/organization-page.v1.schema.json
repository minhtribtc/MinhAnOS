{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-organization-page.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "status": {
            "enum": [
              "active",
              "suspended"
            ]
          },
          "allowChildren": {
            "type": "boolean"
          },
          "isDefault": {
            "type": "boolean"
          },
          "role": {
            "enum": [
              "root",
              "admin",
              "manager",
              "member"
            ]
          },
          "memberCount": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "parentId",
          "depth",
          "status",
          "allowChildren",
          "isDefault",
          "role",
          "memberCount",
          "version"
        ]
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "nextCursor"
  ]
}
