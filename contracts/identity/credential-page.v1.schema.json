{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-credential-page.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "password",
              "webauthn",
              "totp",
              "recovery"
            ]
          },
          "lastChangedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "state": {
            "enum": [
              "active",
              "revoked",
              "unsupported"
            ]
          }
        },
        "required": [
          "id",
          "userId",
          "kind",
          "lastChangedAt",
          "state"
        ]
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "nextCursor"
  ]
}
