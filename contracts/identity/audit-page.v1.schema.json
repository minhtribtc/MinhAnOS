{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/identity-audit-page.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "targetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "success",
              "failure",
              "denied"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "details": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reasonCode": {
                "type": "string"
              },
              "changedFields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "realm": {
                "enum": [
                  "desktop",
                  "files"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 21
              }
            },
            "required": []
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "actorId",
          "action",
          "targetId",
          "outcome",
          "occurredAt",
          "requestId",
          "details"
        ]
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "nextCursor"
  ]
}
