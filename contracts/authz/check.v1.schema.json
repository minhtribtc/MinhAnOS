{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/authz-check.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "files.read",
        "files.write",
        "files.system.read",
        "files.system.write",
        "jobs.read",
        "jobs.create",
        "jobs.cancel",
        "uploads.create",
        "uploads.write",
        "uploads.cancel"
      ]
    },
    "resource": {
      "type": "string",
      "pattern": "^(file|job|upload):[^\\s]+$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appId": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?){2,}$"
        }
      },
      "required": [
        "appId"
      ]
    }
  },
  "required": [
    "action",
    "resource",
    "context"
  ]
}
