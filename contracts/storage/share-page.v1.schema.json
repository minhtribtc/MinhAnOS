{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/storage-share-page.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "volume": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "share",
              "homes"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "limitBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1152921504606847000
              },
              "usedBytes": {
                "type": "integer",
                "minimum": 0
              },
              "reservedBytes": {
                "type": "integer",
                "minimum": 0
              },
              "measured": {
                "type": "boolean"
              }
            },
            "required": [
              "limitBytes",
              "usedBytes",
              "reservedBytes",
              "measured"
            ]
          },
          "physicalBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "volume",
          "kind",
          "version",
          "usage",
          "physicalBytes"
        ]
      }
    }
  },
  "required": [
    "items"
  ]
}
