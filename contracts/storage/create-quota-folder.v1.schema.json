{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/storage-create-quota-folder.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/]+(/[^/]+)*$"
    },
    "limitBytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1152921504606847000
    }
  },
  "required": [
    "path",
    "limitBytes"
  ]
}
