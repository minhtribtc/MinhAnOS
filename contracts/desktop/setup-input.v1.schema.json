{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.minhanos.local/desktop-setup-input.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "setupCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "username": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,31}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 256
    },
    "organizationName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "required": [
    "setupCode",
    "username",
    "displayName",
    "password",
    "organizationName"
  ]
}
